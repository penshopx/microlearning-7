# legacy-peer-deps is required because drizzle-orm@^0.45.2 (security fix for
# GHSA-gpj5-g38j-94v9 SQL-injection) has peerOptional dependencies
# (expo-sqlite, @op-engineering/op-sqlite) whose transitive chains require
# react-native → react@19, conflicting with this project's react@18.
# Those SQLite adapters are unused in this app (it uses PostgreSQL via pg/drizzle-orm/node-postgres).
legacy-peer-deps=true
